{
  "name": "sandbox-atlas",
  "displayName": "Sandbox Atlas",
  "description": "Chat with your codebase, map it in seconds and see what breaks before you change it. Local-first, works offline with Ollama, 15 modes.",
  "version": "0.2.0",
  "publisher": "nexkeys",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexkeys/sandbox-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/Nexkeys/sandbox-atlas/issues"
  },
  "homepage": "https://github.com/Nexkeys/sandbox-atlas#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Themes",
    "Other"
  ],
  "keywords": [
    "codebase map",
    "dependency graph",
    "impact analysis",
    "architecture",
    "ollama",
    "offline ai",
    "vibe coding",
    "react",
    "theme",
    "hacker theme"
  ],
  "pricing": "Free",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces Sandbox Atlas ignores workspace-level AI settings (endpoint, provider, models), so a cloned repository cannot redirect your code or influence commands.",
      "restrictedConfigurations": [
        "sandboxAtlas.ai.baseUrl",
        "sandboxAtlas.ai.mode",
        "sandboxAtlas.ai.offlineModel",
        "sandboxAtlas.ai.onlineModel"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Sandbox Atlas indexes files from the local disk."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sandboxAtlas",
          "title": "Sandbox Atlas",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "sandboxAtlas": [
        {
          "type": "webview",
          "id": "sandboxAtlas.chat",
          "name": "Chat",
          "contextualTitle": "Sandbox Atlas"
        },
        {
          "id": "sandboxAtlas.map",
          "name": "Atlas Map",
          "contextualTitle": "Sandbox Atlas"
        },
        {
          "id": "sandboxAtlas.overview",
          "name": "Overview",
          "contextualTitle": "Sandbox Atlas"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sandboxAtlas.map",
        "contents": "Open a folder to map it with Sandbox Atlas.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "sandboxAtlas.map",
        "contents": "Sandbox Atlas maps your code locally. Nothing leaves your machine unless you choose an online AI provider.\n[Scan Workspace](command:sandboxAtlas.scanWorkspace)\n[Get Started](command:sandboxAtlas.openWalkthrough)",
        "when": "workbenchState != empty"
      }
    ],
    "commands": [
      {
        "command": "sandboxAtlas.openChat",
        "title": "Open Chat",
        "category": "Sandbox Atlas",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sandboxAtlas.askAboutFile",
        "title": "Ask Atlas About This File",
        "category": "Sandbox Atlas",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sandboxAtlas.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Sandbox Atlas",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "sandboxAtlas.refreshAtlas",
        "title": "Refresh Atlas",
        "category": "Sandbox Atlas",
        "icon": "$(refresh)"
      },
      {
        "command": "sandboxAtlas.showGraph",
        "title": "Show Dependency Graph",
        "category": "Sandbox Atlas",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "sandboxAtlas.showGraphForFile",
        "title": "Show Dependency Graph for File",
        "category": "Sandbox Atlas",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "sandboxAtlas.generateProjectMap",
        "title": "Generate Project Map",
        "category": "Sandbox Atlas",
        "icon": "$(map)"
      },
      {
        "command": "sandboxAtlas.exportAtlasNotes",
        "title": "Export Atlas Notes (ATLAS.md)",
        "category": "Sandbox Atlas",
        "icon": "$(export)"
      },
      {
        "command": "sandboxAtlas.traceFeature",
        "title": "Trace Feature",
        "category": "Sandbox Atlas",
        "icon": "$(search)"
      },
      {
        "command": "sandboxAtlas.summarizeDocs",
        "title": "Summarize Docs",
        "category": "Sandbox Atlas",
        "icon": "$(book)"
      },
      {
        "command": "sandboxAtlas.analyzeImpact",
        "title": "Analyze Impact",
        "category": "Sandbox Atlas",
        "icon": "$(pulse)"
      },
      {
        "command": "sandboxAtlas.generateEditPlan",
        "title": "Generate Edit Plan",
        "category": "Sandbox Atlas",
        "icon": "$(checklist)"
      },
      {
        "command": "sandboxAtlas.customizeAppearance",
        "title": "Customize Appearance (Mode, Fonts, Icons)",
        "category": "Sandbox Atlas",
        "icon": "$(symbol-color)"
      },
      {
        "command": "sandboxAtlas.selectMode",
        "title": "Select Mode",
        "category": "Sandbox Atlas",
        "icon": "$(paintcan)"
      },
      {
        "command": "sandboxAtlas.toggleEffects",
        "title": "Toggle Visual Effects",
        "category": "Sandbox Atlas",
        "icon": "$(sparkle)"
      },
      {
        "command": "sandboxAtlas.setupAi",
        "title": "Set Up AI",
        "category": "Sandbox Atlas",
        "icon": "$(wand)"
      },
      {
        "command": "sandboxAtlas.selectAiProvider",
        "title": "Select AI Provider",
        "category": "Sandbox Atlas",
        "icon": "$(hubot)"
      },
      {
        "command": "sandboxAtlas.setApiKey",
        "title": "Set AI API Key",
        "category": "Sandbox Atlas",
        "icon": "$(key)"
      },
      {
        "command": "sandboxAtlas.testConnection",
        "title": "Test AI Connection",
        "category": "Sandbox Atlas",
        "icon": "$(plug)"
      },
      {
        "command": "sandboxAtlas.allowIgnoredFiles",
        "title": "Toggle Ignored Files (This Session)",
        "category": "Sandbox Atlas",
        "icon": "$(eye)"
      },
      {
        "command": "sandboxAtlas.showIndexStatus",
        "title": "Show Index Status",
        "category": "Sandbox Atlas",
        "icon": "$(info)"
      },
      {
        "command": "sandboxAtlas.showLogs",
        "title": "Show Logs",
        "category": "Sandbox Atlas",
        "icon": "$(output)"
      },
      {
        "command": "sandboxAtlas.openWalkthrough",
        "title": "Get Started",
        "category": "Sandbox Atlas",
        "icon": "$(rocket)"
      }
    ],
    "submenus": [
      {
        "id": "sandboxAtlas.fileMenu",
        "label": "Sandbox Atlas"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sandboxAtlas.customizeAppearance",
          "when": "view == sandboxAtlas.overview",
          "group": "navigation@0"
        },
        {
          "command": "sandboxAtlas.showGraph",
          "when": "view == sandboxAtlas.map",
          "group": "navigation@1"
        },
        {
          "command": "sandboxAtlas.generateProjectMap",
          "when": "view == sandboxAtlas.map",
          "group": "navigation@2"
        },
        {
          "command": "sandboxAtlas.refreshAtlas",
          "when": "view == sandboxAtlas.map",
          "group": "navigation@3"
        },
        {
          "command": "sandboxAtlas.exportAtlasNotes",
          "when": "view == sandboxAtlas.map",
          "group": "1_export"
        },
        {
          "command": "sandboxAtlas.allowIgnoredFiles",
          "when": "view == sandboxAtlas.map",
          "group": "2_settings"
        },
        {
          "command": "sandboxAtlas.selectAiProvider",
          "when": "view == sandboxAtlas.overview",
          "group": "navigation@1"
        },
        {
          "command": "sandboxAtlas.openWalkthrough",
          "when": "view == sandboxAtlas.overview",
          "group": "navigation@2"
        },
        {
          "command": "sandboxAtlas.selectMode",
          "when": "view == sandboxAtlas.map",
          "group": "2_settings"
        }
      ],
      "view/item/context": [
        {
          "command": "sandboxAtlas.analyzeImpact",
          "when": "view == sandboxAtlas.map && viewItem == atlasCodeFile",
          "group": "inline@1"
        },
        {
          "command": "sandboxAtlas.showGraphForFile",
          "when": "view == sandboxAtlas.map && viewItem == atlasCodeFile",
          "group": "inline@2"
        },
        {
          "command": "sandboxAtlas.analyzeImpact",
          "when": "view == sandboxAtlas.map && viewItem == atlasCodeFile",
          "group": "1_atlas@1"
        },
        {
          "command": "sandboxAtlas.generateEditPlan",
          "when": "view == sandboxAtlas.map && viewItem == atlasCodeFile",
          "group": "1_atlas@2"
        },
        {
          "command": "sandboxAtlas.showGraphForFile",
          "when": "view == sandboxAtlas.map && viewItem == atlasCodeFile",
          "group": "1_atlas@3"
        },
        {
          "command": "sandboxAtlas.askAboutFile",
          "when": "view == sandboxAtlas.map && viewItem == atlasCodeFile",
          "group": "1_atlas@0"
        }
      ],
      "explorer/context": [
        {
          "submenu": "sandboxAtlas.fileMenu",
          "when": "resourceExtname =~ /^\\.(ts|tsx|js|jsx|mjs|cjs)$/",
          "group": "7_modification@9"
        }
      ],
      "editor/context": [
        {
          "submenu": "sandboxAtlas.fileMenu",
          "when": "resourceExtname =~ /^\\.(ts|tsx|js|jsx|mjs|cjs)$/",
          "group": "1_modification@9"
        }
      ],
      "sandboxAtlas.fileMenu": [
        {
          "command": "sandboxAtlas.askAboutFile",
          "group": "0_chat@1"
        },
        {
          "command": "sandboxAtlas.analyzeImpact",
          "group": "1_ai@1"
        },
        {
          "command": "sandboxAtlas.generateEditPlan",
          "group": "1_ai@2"
        },
        {
          "command": "sandboxAtlas.showGraphForFile",
          "group": "2_map@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sandboxAtlas.showGraphForFile",
          "when": "editorIsOpen"
        },
        {
          "command": "sandboxAtlas.askAboutFile",
          "when": "editorIsOpen"
        }
      ]
    },
    "configuration": {
      "title": "Sandbox Atlas",
      "properties": {
        "sandboxAtlas.ai.mode": {
          "type": "string",
          "default": "offline-ollama",
          "enum": [
            "offline-ollama",
            "offline-lmstudio",
            "online-gemini",
            "online-openrouter",
            "online-openai"
          ],
          "enumDescriptions": [
            "Local Ollama server (default, free, private)",
            "Local LM Studio server",
            "Google Gemini (API key required)",
            "OpenRouter (API key required)",
            "OpenAI (API key required)"
          ],
          "markdownDescription": "Which AI provider powers Trace Feature, Summarize Docs, Analyze Impact and Edit Plans. Online modes send code context to that provider; set the key with **Sandbox Atlas: Set AI API Key**.",
          "order": 0,
          "tags": [
            "usesOnlineServices"
          ]
        },
        "sandboxAtlas.ai.offlineModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model for offline modes. Empty uses `qwen2.5-coder:3b`.",
          "order": 1
        },
        "sandboxAtlas.ai.onlineModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model for online modes. Empty uses the provider default (`gemini-2.5-flash`, `gpt-4o-mini`, `mistralai/mistral-7b-instruct`).",
          "order": 2,
          "tags": [
            "usesOnlineServices"
          ]
        },
        "sandboxAtlas.ai.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Override the OpenAI-compatible endpoint, e.g. `http://localhost:11435/v1`. Empty uses the default for the selected mode.",
          "order": 3,
          "tags": [
            "usesOnlineServices"
          ]
        },
        "sandboxAtlas.ai.requestTimeoutSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Abort AI requests that take longer than this many seconds. `0` = automatic: 300 s for local models (CPU inference can be slow), 120 s for online providers.",
          "order": 4
        },
        "sandboxAtlas.ai.dailyRequestLimit": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "markdownDescription": "Maximum AI requests per day for **online** providers (cost guard). `0` = unlimited. Offline usage is never limited.",
          "order": 5
        },
        "sandboxAtlas.index.autoRefresh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Re-index changed files automatically when they are saved, created or deleted.",
          "order": 10
        },
        "sandboxAtlas.appearance.mode": {
          "type": "string",
          "default": "classic",
          "enum": [
            "classic",
            "vibe",
            "hacker",
            "soft",
            "midnight",
            "sunset",
            "blueprint",
            "zen",
            "retro",
            "synthwave",
            "solar",
            "groove",
            "arctic",
            "cyberpunk",
            "arcade"
          ],
          "enumDescriptions": [
            "Classic: Native look — follows your VS Code theme",
            "Vibe Coder: Neon gradients, glow and good energy",
            "Hacker: Terminal green on black, monospace, CRT scanlines",
            "Soft: Calm pastels on cream, rounded and gentle",
            "Midnight: Deep navy and moonlit blues for late sessions",
            "Sunset: Warm oranges and rose, golden-hour energy",
            "Blueprint: Engineering blueprint: white ink on a cyan-blue grid",
            "Zen: Ink on paper — minimal, serif, distraction-free",
            "Retro Terminal: Amber CRT monitor: VT323 pixel type, scanlines and phosphor glow",
            "Synthwave: '80s neon: hot pink and cyan glow over a purple night",
            "Solar: Solarized-inspired teal and gold, IBM Plex type",
            "Groove: Gruvbox-inspired warm retro colours, Fira type with ligatures",
            "Arctic: Nord-inspired cool frost blues, clean Inter type",
            "Cyberpunk: Night-city yellow and cyan, cut-corner panels, Orbitron headings",
            "Arcade: 8-bit console palette, pixel borders and Press Start 2P headings"
          ],
          "markdownDescription": "How Sandbox Atlas looks — colours, fonts, icons, shapes and effects across the graph, chat, results panel, sidebar and status bar. Use **Sandbox Atlas: Customize Appearance** to preview everything live.",
          "order": 20
        },
        "sandboxAtlas.appearance.effects": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Glow and scanline effects in modes that use them. Always off when your OS asks for reduced motion and in high-contrast themes.",
          "order": 21
        },
        "sandboxAtlas.appearance.applyColorTheme": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask before switching VS Code to the matching colour theme",
            "Always switch VS Code to the matching colour theme",
            "Never change the VS Code colour theme"
          ],
          "markdownDescription": "Whether choosing a mode also switches VS Code to its matching **Sandbox Atlas** colour theme. Classic restores your previous theme.",
          "order": 22
        },
        "sandboxAtlas.results.view": {
          "type": "string",
          "default": "panel",
          "enum": [
            "panel",
            "markdown"
          ],
          "enumDescriptions": [
            "Themed Atlas Results panel with copy and save actions",
            "VS Code built-in markdown preview"
          ],
          "markdownDescription": "Where AI answers and project maps open.",
          "order": 23
        },
        "sandboxAtlas.appearance.uiFont": {
          "type": "string",
          "default": "mode",
          "enum": [
            "mode",
            "editor",
            "Inter",
            "Poppins",
            "Nunito",
            "Space Grotesk",
            "IBM Plex Sans",
            "Fira Sans",
            "Source Serif 4",
            "Orbitron",
            "VT323",
            "Press Start 2P"
          ],
          "enumDescriptions": [
            "The active mode's font",
            "VS Code's UI font",
            "Bundled font",
            "Bundled font",
            "Bundled font",
            "Bundled font",
            "Bundled font",
            "Bundled font",
            "Bundled font",
            "Bundled font",
            "Bundled font",
            "Bundled font"
          ],
          "markdownDescription": "Font for Atlas panels (graph, chat, results). Fonts are bundled, so nothing needs installing.",
          "order": 24
        },
        "sandboxAtlas.appearance.codeFont": {
          "type": "string",
          "default": "mode",
          "enum": [
            "mode",
            "editor",
            "JetBrains Mono",
            "Fira Code",
            "IBM Plex Mono",
            "Space Mono",
            "VT323"
          ],
          "enumDescriptions": [
            "The active mode's code font",
            "VS Code's editor font",
            "Bundled font",
            "Bundled font",
            "Bundled font",
            "Bundled font",
            "Bundled font"
          ],
          "markdownDescription": "Monospace font for code and file paths in Atlas panels.",
          "order": 25
        },
        "sandboxAtlas.appearance.iconSet": {
          "type": "string",
          "default": "mode",
          "enum": [
            "mode",
            "classic",
            "terminal",
            "minimal",
            "playful",
            "technical",
            "geometric",
            "pixel"
          ],
          "enumDescriptions": [
            "The active mode's icons",
            "Classic VS Code symbols",
            "Terminal prompts and chevrons",
            "Minimal dots and circles",
            "Playful sparkles and stars",
            "Technical schematics",
            "Geometric shapes",
            "Pixel / 8-bit"
          ],
          "markdownDescription": "Icons used in the Atlas Map, Overview and dependency graph node shapes.",
          "order": 26
        }
      }
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with Sandbox Atlas",
        "description": "Map your codebase and ask it questions, offline or online.",
        "steps": [
          {
            "id": "chooseProvider",
            "title": "Choose your AI provider",
            "description": "Run fully offline with **Ollama** or **LM Studio** (free, private), or use Gemini, OpenAI or OpenRouter with your own key.\n[Select AI Provider](command:sandboxAtlas.selectAiProvider)",
            "media": {
              "markdown": "media/walkthrough/provider.md"
            },
            "completionEvents": [
              "onCommand:sandboxAtlas.selectAiProvider",
              "onSettingChanged:sandboxAtlas.ai.mode"
            ]
          },
          {
            "id": "pickMode",
            "title": "Make it yours",
            "description": "Pick one of 15 modes: Vibe Coder, Hacker, Retro Terminal, Synthwave, Cyberpunk, Arcade, Solar, Groove, Arctic and more. Each changes colours, fonts, icons and shapes; you can also mix in your own font and icon set.\n[Customize Appearance](command:sandboxAtlas.customizeAppearance)",
            "media": {
              "image": "media/screenshots/modes.png",
              "altText": "The eight Sandbox Atlas modes"
            },
            "completionEvents": [
              "onCommand:sandboxAtlas.selectMode",
              "onCommand:sandboxAtlas.customizeAppearance",
              "onSettingChanged:sandboxAtlas.appearance.mode"
            ]
          },
          {
            "id": "testConnection",
            "title": "Check your AI is ready",
            "description": "No local model yet? Sandbox Atlas walks you through installing Ollama, downloading a model, or using a free-tier Gemini key.\n[Set Up AI](command:sandboxAtlas.setupAi)",
            "media": {
              "markdown": "media/walkthrough/connection.md"
            },
            "completionEvents": [
              "onCommand:sandboxAtlas.setupAi",
              "onCommand:sandboxAtlas.testConnection"
            ]
          },
          {
            "id": "exploreMap",
            "title": "Explore your Atlas",
            "description": "Your workspace is indexed automatically. Browse the **Atlas Map**, or open the interactive dependency graph.\n[Show Dependency Graph](command:sandboxAtlas.showGraph)",
            "media": {
              "image": "media/screenshots/graph.png",
              "altText": "Atlas dependency graph"
            },
            "completionEvents": [
              "onCommand:sandboxAtlas.showGraph",
              "onView:sandboxAtlas.map"
            ]
          },
          {
            "id": "askAtlas",
            "title": "Chat with your codebase",
            "description": "Open **Chat** in the Sandbox Atlas sidebar (Ctrl+Alt+A) and ask anything, or type / for commands like /trace, /impact and /plan.\n[Open Chat](command:sandboxAtlas.openChat)",
            "media": {
              "image": "media/screenshots/trace.png",
              "altText": "Feature trace answered by a local Ollama model"
            },
            "completionEvents": [
              "onCommand:sandboxAtlas.openChat",
              "onCommand:sandboxAtlas.traceFeature",
              "onCommand:sandboxAtlas.analyzeImpact",
              "onView:sandboxAtlas.chat"
            ]
          }
        ]
      }
    ],
    "themes": [
      {
        "label": "Sandbox Atlas Vibe",
        "uiTheme": "vs-dark",
        "path": "./themes/atlas-vibe-color-theme.json"
      },
      {
        "label": "Sandbox Atlas Hacker",
        "uiTheme": "vs-dark",
