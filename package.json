      },
      {
        "label": "Sandbox Atlas Soft",
        "uiTheme": "vs",
        "path": "./themes/atlas-soft-color-theme.json"
      },
      {
        "label": "Sandbox Atlas Midnight",
        "uiTheme": "vs-dark",
