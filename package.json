      },
      {
        "label": "Sandbox Atlas Zen",
        "uiTheme": "vs",
        "path": "./themes/atlas-zen-color-theme.json"
      },
      {
        "label": "Sandbox Atlas Retro Terminal",
        "uiTheme": "vs-dark",
        "path": "./themes/atlas-retro-color-theme.json"
      },
      {
        "label": "Sandbox Atlas Synthwave",
        "uiTheme": "vs-dark",
        "path": "./themes/atlas-synthwave-color-theme.json"
      },
      {
        "label": "Sandbox Atlas Solar",
        "uiTheme": "vs-dark",
