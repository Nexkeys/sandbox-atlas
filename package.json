        "label": "Sandbox Atlas Arcade",
        "uiTheme": "vs-dark",
        "path": "./themes/atlas-arcade-color-theme.json"
      }
    ],
    "keybindings": [
      {
        "command": "sandboxAtlas.openChat",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:production",
    "build": "node esbuild.js",
    "build:production": "node esbuild.js --production",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview",
    "lint": "eslint src",
    "verify": "npm run check-types && npm run lint && npm run test:unit",
