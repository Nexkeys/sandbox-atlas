{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"types": ["node", "mocha"]
	},
	"include": [
		"src"
	],
	"exclude": [
		"src/webview"
	]
}
